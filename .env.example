# Supabase > Project Settings > Database > Connection string > Session pooler
# 비밀번호의 특수문자는 그대로 붙여넣어도 됩니다(lib/database.ts 가 URL 인코딩합니다).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<YOUR_PASSWORD>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Storage/Auth 를 쓸 때만 필요합니다.
NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# vector(1536) 컬럼에 맞춰 1536차원 모델을 사용하세요.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 후보 하한선 / 1등 청크 하한선 (코사인 유사도)
RAG_SIMILARITY_THRESHOLD=0.24
RAG_TOP_MATCH_THRESHOLD=0.3
RAG_MATCH_COUNT=6
RAG_CANDIDATE_COUNT=40
RAG_CONTEXT_CHARS=12000

# 관리자로 지정할 구글 계정(쉼표 구분). 채우면 비밀번호 대신 이 계정만 허용합니다.
ADMIN_EMAILS=

# ADMIN_EMAILS 를 쓰지 않을 때의 예전 방식. 둘 다 있으면 ADMIN_EMAILS 가 우선합니다.
ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# 욕설·비방 차단은 항상 켜져 있습니다. on 으로 두면 모더레이션 API 로 한 번 더 검사합니다(+1초).
MODERATION_API=off

RATE_LIMIT_CHAT=12
RATE_LIMIT_WINDOW_SECONDS=60

NEXT_PUBLIC_APP_NAME=답봇
