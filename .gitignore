# 의존성
node_modules

# Next.js 빌드 산출물
# next.config.ts 가 환경에 따라 .next / .next-dev / .next-build 로 나눠 쓰므로
# .next 로 시작하는 폴더를 모두 제외합니다(.next 만 적으면 .next-build 가 걸리지 않습니다).
.next
.next-*
out
build

# 환경변수 — API 키와 DB 비밀번호가 들어 있습니다. 절대 커밋하지 마세요.
.env
.env.*
!.env.example

# 테스트/커버리지
coverage

# TypeScript 증분 빌드 캐시
*.tsbuildinfo

# 로컬 도구 설정
.claude/settings.local.json
.vercel

# 교육 과정 텔레메트리 하네스 배포본.
# 설치가 끝나면 필요한 파일은 .codex 로 복사되므로 원본 폴더는 남기지 않습니다.
# 남겨 두면 no-public-secret / server-boundary 검사가 실패합니다.
student-telemetry-harness/
harness.pdf

# 하네스가 설치한 로컬 에이전트 도구.
# .codex/hooks/policy-lock.json 에 팀 토큰의 SHA-256 지문이 들어 있어
# 저장소에 올리지 않습니다. 로컬에는 그대로 남아 검사 도구가 계속 동작합니다.
# 실행에 필요한 코드는 lib/server/telemetry.server.ts 뿐이며 그것은 커밋됩니다.
.codex/

# OS / 편집기
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
.idea
.vscode/*
!.vscode/extensions.json

