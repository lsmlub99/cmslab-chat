# Next.js 빌드 산출물
# next.config.ts 가 환경에 따라 .next / .next-dev / .next-build 로 나눠 쓰므로
# .next 로 시작하는 폴더를 모두 제외합니다(.next 만 적으면 .next-build 가 걸리지 않습니다).
.next
.next-*
out
build

# 환경변수 — API 키와 DB 비밀번호가 들어 있습니다. 절대 커밋하지 마세요.
.env
.env.*
!.env.example

